{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "echoguard-dashboard",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "streamlit", "run", "app.py", "--server.headless", "true", "--server.port", "8501"],
      "port": 8501
    },
    {
      "name": "echoguard-site",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "http.server", "8610", "--directory", "site"],
      "port": 8610
    }
  ]
}
